{% macro table(rows, which) %}
{{ "%-18s %9s %9s  %9s %8s %8s  %9s %8s %8s %8s  %7s %8s %9s"|format("program", "NumPy ms", "installed", "lazy ms", "build", "compute", "fused ms", "build", "plan", "compute", "vs lazy", "vs NumPy", "vs inst.") }}
{% for row in rows %}
{% set t = row.timings if which == "plain" else row.installed %}
{% set eager = row.timings[installed] if which == "plain" else row.installed[numpy] %}
{{ "%-18s %9.2f %9.2f  %9.2f %8.2f %8.2f  %9.2f %8.2f %8.2f %8.2f  %6.2fx %7.2fx %8.2fx"|format(row.name, row.timings[numpy].total_ns / ns_per_ms, eager.total_ns / ns_per_ms, t[lazy].total_ns / ns_per_ms, t[lazy].building_ns / ns_per_ms, t[lazy].computing_ns / ns_per_ms, t[fused].total_ns / ns_per_ms, t[fused].building_ns / ns_per_ms, t[fused].planning_ns / ns_per_ms, (t[fused].computing_ns - t[fused].planning_ns) / ns_per_ms, t[lazy].total_ns / t[fused].total_ns, row.timings[numpy].total_ns / t[fused].total_ns, eager.total_ns / t[fused].total_ns) }}
{% endfor %}
{% endmacro %}
