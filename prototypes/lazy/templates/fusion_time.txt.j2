{{ "%-17s %8d %7d %8d %12d  %6d %6d %7d %6d %6d %6d %6d  %9.1f %9.1f"|format(row.name, row.lazy.deferred, row.lazy.graphs, row.lazy.largest_graph, row.lazy.largest_node, row.stats.expressions, row.stats.tiled, row.stats.calls.values()|sum, row.stats.fused_nodes, row.stats.declined + row.stats.flagged, row.stats.whole_writes, row.stats.part_writes, row.lazy.written / bytes_per_mb, row.fused.written / bytes_per_mb) }}
