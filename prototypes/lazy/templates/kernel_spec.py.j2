HUGE, TINY = 1e300, 1e-310

SCALAR_SETS = [
{% for number in numbers %}
{% for trial, value in trials %}
    ScalarSet("{{ trial }}_{{ number }}", {"{{ number }}": {{ value }}}),
{% endfor %}
{% endfor %}
