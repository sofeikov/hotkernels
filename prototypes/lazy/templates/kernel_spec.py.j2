    return {{ python }}


KERNEL = Kernel(
    name="{{ name }}",
    returns="void",
    args=[
{% for array in arrays %}
        In("{{ array }}", "f64"),
{% endfor %}
        Out("out", "f64"),
        Size("n"),
{% for number in numbers %}
        Scalar("{{ number }}", "f64", {{ number|upper }}),
