// out[i] = {{ c }}, every operation rounded by itself, in that order.
//
// The pragma keeps the compiler from fusing a product and a sum into one
// multiply-add, which rounds once and gives other bits than NumPy's passes.
#pragma STDC FP_CONTRACT OFF

void {{ name }}(
{% for array in arrays %}
    const double *{{ array }},
{% endfor %}
    double *out,
    size_t n{{ "," if numbers }}
{% for number in numbers %}
    double {{ number }}{{ "," if not loop.last }}
{% endfor %}
) {
    for (size_t i = 0; i < n; i++) {
        out[i] = {{ c }};
    }
}
