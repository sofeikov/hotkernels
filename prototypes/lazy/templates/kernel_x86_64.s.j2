.intel_syntax noprefix
# void {{ name }}({% for array in arguments %}const double *{{ array }}, {% endfor %}double *out, size_t n{% for number in numbers %}, double {{ number }}{% endfor %});
# out[i] = {{ c }}
#
# {% for array in arguments %}{{ array }} = {{ registers[loop.index0] }}, {% endfor %}out = {{ out_argument }}, n = {{ length_argument }}{% for number in numbers %}, {{ number }} = xmm{{ loop.index0 }}{% endfor %}.
#
# A fused kernel for the shape {{ shape }}, written by
# prototypes/lazy/make_kernel.py from that name. Every operation is one AVX
# instruction that rounds once, in the order NumPy's passes make them: no
# multiply-add, and a division is a division.{% if extremes %} np.maximum and
# np.minimum are vmaxpd and vminpd with a NaN of the first operand carried
# through, which is NumPy's rule on x86-64: of two zeros, the second operand.{% endif %}

#
# Eight elements per iteration, two ymm registers of four, every address
# the array's base plus the index in rax. Every load of an iteration comes
# before its store, so out may be one of the arrays itself for a length that
# is a multiple of eight or below eight. A remainder of 1 to 7 elements is
# one more block that ends exactly at the end of the arrays and overlaps the
# block before it, computed from the arrays again: there out must not overlap
# an array. Fewer than 8 elements are done one at a time.

.text
.globl {{ name }}
.type {{ name }}, @function
.p2align 4
{{ name }}:
{% for register, offset in stack %}
    mov     {{ register }}, qword ptr [rsp + {{ offset }}]
{% endfor %}
    xor     eax, eax
    cmp     {{ length }}, {{ block }}
    jb      .Lsmall
{% for number in numbers %}
    vbroadcastsd ymm{{ top - loop.index0 }}, xmm{{ loop.index0 }}     # {{ number }} in every lane
{% endfor %}
{% for label, register in constants %}
    vbroadcastsd ymm{{ register }}, qword ptr [rip + {{ label }}]
{% endfor %}
    sub     {{ length }}, {{ block }}                # where the last block starts
.Lblock:
{% for mnemonic, operands in wide %}
    {{ "%-11s"|format(mnemonic) }} {{ operands }}
{% endfor %}
    add     rax, {{ block }}
    cmp     rax, {{ length }}
    jbe     .Lblock
    sub     rax, {{ block }}                 # where the block just done started
    cmp     rax, {{ length }}
    je      .Ldone
    mov     rax, {{ length }}                # 1 to 7 left: the block that ends with the arrays
    jmp     .Lblock
.Lsmall:
    test    {{ length }}, {{ length }}
    jz      .Ldone
{% for label, register in constants %}
    vmovsd  xmm{{ register }}, qword ptr [rip + {{ label }}]
{% endfor %}
.Lone:
{% for mnemonic, operands in narrow %}
    {{ "%-11s"|format(mnemonic) }} {{ operands }}
{% endfor %}
    inc     rax
    cmp     rax, {{ length }}
    jb      .Lone
.Ldone:
    vzeroupper
    ret
.size {{ name }}, .-{{ name }}
{% if data %}

.section .rodata
.p2align 3
{% for label, bits in data %}
{{ label }}:
    .quad   {{ bits }}
{% endfor %}
{% endif %}

.section .note.GNU-stack,"",@progbits
